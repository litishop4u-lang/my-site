---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getCollection } from 'astro:content';
import { getSettings, getCategories, getProducts, getBanners } from '../lib/db';

const [settings, categories, products, dbBanners] = await Promise.all([
  getSettings(),
  getCategories(),
  getProducts({ limit: 200 }),
  getBanners(),
]);

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const sections = categories
  .filter((c) => c.show_on_home === 1)
  .map((c) => ({
    category: c,
    products: products.filter((p) => p.category_id === c.id).slice(0, 8),
  }))
  .filter((s) => s.products.length > 0);

const siteName = settings.site_name || 'Tên Website';
const heroImage = settings.hero_image || '';
const pageTitle = [siteName, settings.hero_subtitle].filter(Boolean).join(' - ');
const pageDescription =
  settings.hero_text || 'Chuyên cung cấp sản phẩm chính hãng, giá tốt, bảo hành rõ ràng.';
const intervalMs = Math.min(30, Math.max(2, Number(settings.banner_interval) || 5)) * 1000;

const banners =
  dbBanners.length > 0
    ? dbBanners.map((b) => ({ image: b.image, alt: b.alt || siteName, link: b.link_url || '' }))
    : heroImage
      ? [{ image: heroImage, alt: siteName, link: '' }]
      : [];
---

<BaseLayout title={pageTitle} description={pageDescription} wide={true}>
  <h1 class="sr-only">{settings.hero_title || siteName}</h1>

  {banners.length > 0 && (
    <section class="banner-slider" data-banner data-interval={intervalMs} aria-label="Banner">
      <div class="banner-frame" data-frame>
        <div class="banner-track">
          {banners.map((b, i) => (
            <div class:list={['banner-slide', { active: i === 0 }]} data-slide>
              {b.link ? (
                <a href={b.link}>
                  <img
                    src={b.image}
                    alt={b.alt}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : undefined}
                  />
                </a>
              ) : (
                <img
                  src={b.image}
                  alt={b.alt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
              )}
            </div>
          ))}
        </div>
        {banners.length > 1 && (
          <>
            <button type="button" class="banner-nav prev" data-prev aria-label="Banner trước">‹</button>
            <button type="button" class="banner-nav next" data-next aria-label="Banner sau">›</button>
            <div class="banner-dots">
              {banners.map((b, i) => (
                <button
                  type="button"
                  class:list={['banner-dot', { active: i === 0 }]}
                  data-dot
                  aria-label={`Xem banner ${i + 1}`}
                ></button>
              ))}
            </div>
          </>
        )}
      </div>
    </section>
  )}

  {sections.length === 0 && (
    <section class="section">
      <div class="container">
        <p class="empty-note">Chưa có sản phẩm nào.</p>
      </div>
    </section>
  )}

  {sections.map((section) => (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title"><span class="ribbon">{section.category.name}</span></h2>
          <a class="section-more" href={`/danh-muc/${section.category.slug}/`}>Xem thêm</a>
        </div>
        <div class="grid-4">
          {section.products.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  ))}

  {posts.length > 0 && (
    <section class="section news-section">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title"><span class="ribbon">Tin tức – Sự kiện</span></h2>
          <a class="section-more" href="/blog/">Xem thêm</a>
        </div>
        <div class="grid-3">
          {posts.map((post) => (
            <article class="news-card">
              <div class="thumb"></div>
              <div class="body">
                <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
                <p>{post.data.description}</p>
                <a class="link-more" href={`/blog/${post.id}/`}>Xem thêm</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <script is:inline defer src="/banner.js?v=2"></script>
</BaseLayout>