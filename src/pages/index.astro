---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getCollection } from 'astro:content';
import { getSettings, getCategories, getProducts } from '../lib/db';

const [settings, categories, products] = await Promise.all([
  getSettings(),
  getCategories(),
  getProducts({ limit: 200 }),
]);

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const sections = categories
  .filter((c) => c.show_on_home === 1)
  .map((c) => ({
    category: c,
    products: products.filter((p) => p.category_id === c.id).slice(0, 8),
  }))
  .filter((s) => s.products.length > 0);

const siteName = settings.site_name || 'Tên Website';
const heroImage = settings.hero_image || '';
const pageTitle = [siteName, settings.hero_subtitle].filter(Boolean).join(' - ');
const pageDescription =
  settings.hero_text || 'Chuyên cung cấp sản phẩm chính hãng, giá tốt, bảo hành rõ ràng.';
---

<BaseLayout title={pageTitle} description={pageDescription} wide={true}>
  <section class="hero" style={heroImage ? `--hero-image: url('${heroImage}')` : undefined}>
    <div class="container">
      <h1>{settings.hero_title || siteName}</h1>
      {settings.hero_subtitle && <p class="sub">{settings.hero_subtitle}</p>}
      {settings.hero_text && <p>{settings.hero_text}</p>}
      <a class="btn" href="/lien-he/">Liên hệ ngay ›</a>
    </div>
  </section>

  {sections.length === 0 && (
    <section class="section">
      <div class="container">
        <p class="empty-note">Chưa có sản phẩm nào.</p>
      </div>
    </section>
  )}

  {sections.map((section) => (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title"><span class="ribbon">{section.category.name}</span></h2>
          <a class="section-more" href={`/danh-muc/${section.category.slug}/`}>Xem thêm</a>
        </div>
        <div class="grid-4">
          {section.products.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  ))}

  {posts.length > 0 && (
    <section class="section news-section">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title"><span class="ribbon">Tin tức – Sự kiện</span></h2>
          <a class="section-more" href="/blog/">Xem thêm</a>
        </div>
        <div class="grid-3">
          {posts.map((post) => (
            <article class="news-card">
              <div class="thumb"></div>
              <div class="body">
                <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
                <p>{post.data.description}</p>
                <a class="link-more" href={`/blog/${post.id}/`}>Xem thêm</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>