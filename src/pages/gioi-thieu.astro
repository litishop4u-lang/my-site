---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSettings } from '../lib/db';
import { prepareDescription, htmlToPlainText } from '../lib/rich';

export const prerender = false;

const settings = await getSettings();
const siteName = settings.site_name || 'Chúng tôi';
const title = (settings.about_title || '').trim() || 'Giới thiệu';
const html = await prepareDescription(settings.about_html, title);
const description =
  (settings.about_description || '').trim() ||
  htmlToPlainText(html).slice(0, 155) ||
  `Tìm hiểu về ${siteName}: câu chuyện, sứ mệnh và những gì chúng tôi mang lại cho khách hàng.`;
---

<BaseLayout title={title} description={description} wide={true}>
  <div class="container page-wide post-page">
    <article class="post">
      <h1>{title}</h1>
      {html ? (
        <div class="rich rich-html" set:html={html}></div>
      ) : (
        <p class="empty-note">Nội dung đang được cập nhật.</p>
      )}
    </article>
  </div>
</BaseLayout>