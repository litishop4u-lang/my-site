---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProductBySlug, getRelatedProducts, getSettings, formatPrice } from '../../lib/db';
import { parseImages, parseSpecs } from '../../lib/content';
import { prepareDescription, htmlToPlainText } from '../../lib/rich';

const { slug } = Astro.params;
const product = slug ? await getProductBySlug(slug) : null;
const settings = await getSettings();

if (!product) {
  Astro.response.status = 404;
}

const phone = settings.phone || '';
const zalo = settings.zalo || '';
const url = new URL(Astro.url.pathname, Astro.site).toString();

const images = product ? parseImages(product.images, product.image) : [];
const specs = product ? parseSpecs(product.specs).filter((s) => s.label && s.value) : [];
const descriptionHtml = product ? await prepareDescription(product.description, product.name) : '';
const plainDescription = htmlToPlainText(descriptionHtml);

const related = product ? await getRelatedProducts(product.id, product.category_id, 3) : [];
const relatedItems = related.map((p) => ({
  ...p,
  thumb: parseImages(p.images, p.image)[0] ?? '',
}));

const currentData = product
  ? JSON.stringify({
      slug: product.slug,
      name: product.name,
      price: product.price,
      old_price: product.old_price,
      image: images[0] ?? '',
    }).replace(/</g, '\\u003c')
  : '';

const metaDescription = product
  ? plainDescription.slice(0, 155) ||
    `${product.name}. Liên hệ để được tư vấn và báo giá tốt nhất.`
  : 'Sản phẩm không tồn tại hoặc đã ngừng kinh doanh.';

const productSchema = product
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: product.name,
      description: plainDescription.slice(0, 500) || undefined,
      sku: product.sku || undefined,
      image: images.length > 0 ? images.map((u) => new URL(u, Astro.site).toString()) : undefined,
      brand: product.brand_name ? { '@type': 'Brand', name: product.brand_name } : undefined,
      offers:
        product.price > 0
          ? {
              '@type': 'Offer',
              url,
              priceCurrency: 'VND',
              price: product.price,
              availability: 'https://schema.org/InStock',
            }
          : undefined,
    }
  : undefined;
---

<BaseLayout
  title={product ? product.name : 'Không tìm thấy sản phẩm'}
  description={metaDescription}
  image={images[0]}
  noindex={!product}
  wide={true}
  schema={productSchema}
>
  <div class="container page-wide">
    {product ? (
      <>
        <article class="product-detail">
          <div class="product-media">
            <div class="gallery" data-gallery>
              <div class="gallery-main">
                {images.length > 0 ? (
                  <img data-gallery-main src={images[0]} alt={product.name} />
                ) : (
                  <span>Chưa có ảnh</span>
                )}
                {images.length > 1 && (
                  <>
                    <button type="button" class="gallery-nav prev" data-gallery-prev aria-label="Ảnh trước">‹</button>
                    <button type="button" class="gallery-nav next" data-gallery-next aria-label="Ảnh sau">›</button>
                  </>
                )}
              </div>
              {images.length > 1 && (
                <div class="gallery-thumbs" data-gallery-thumbs>
                  {images.map((src, i) => (
                    <button
                      type="button"
                      class:list={['gallery-thumb', { active: i === 0 }]}
                      data-gallery-thumb
                      data-src={src}
                      aria-label={`Xem ảnh ${i + 1}`}
                    >
                      <img src={src} alt="" loading="lazy" />
                    </button>
                  ))}
                </div>
              )}
            </div>
          </div>

          <div class="product-info">
            <nav class="breadcrumb" aria-label="Đường dẫn">
              <a href="/">Trang chủ</a>
              {product.category_slug && (
                <>
                  {' / '}
                  <a href={`/danh-muc/${product.category_slug}/`}>{product.category_name}</a>
                </>
              )}
            </nav>
            <h1>{product.name}</h1>
            {product.brand_name && <p class="meta-line">Thương hiệu: <strong>{product.brand_name}</strong></p>}
            {product.sku && <p class="meta-line">Mã sản phẩm: {product.sku}</p>}
            <p class="price price-lg">
              {product.old_price > product.price && <del>{formatPrice(product.old_price)}</del>}
              {product.price > 0 ? formatPrice(product.price) : 'Liên hệ để biết giá'}
            </p>
            <div class="actions">
              {phone && <a class="btn" href={`tel:${phone.replace(/\s/g, '')}`}>Gọi {phone}</a>}
              {zalo && (
                <a class="btn btn-outline" href={`https://zalo.me/${zalo.replace(/\s/g, '')}`} rel="noopener" target="_blank">
                  Nhắn Zalo
                </a>
              )}
            </div>

            {specs.length > 0 && (
              <section class="spec-box">
                <h2>Thông số kỹ thuật</h2>
                <table class="spec-table">
                  <tbody>
                    {specs.map((s) => (
                      <tr>
                        <th scope="row">{s.label}</th>
                        <td>{s.value}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </section>
            )}
          </div>
        </article>

        <div class="detail-lower">
          <div class="detail-main">
            {descriptionHtml && (
              <section class="product-description">
                <h2>Mô tả sản phẩm</h2>
                <div class="rich rich-html" set:html={descriptionHtml}></div>
              </section>
            )}
          </div>

          <aside class="detail-side">
            {relatedItems.length > 0 && (
              <section class="side-box">
                <h2>Sản phẩm liên quan</h2>
                <ul class="side-list">
                  {relatedItems.map((p) => (
                    <li class="side-item">
                      <a class="side-thumb" href={`/san-pham/${p.slug}/`}>
                        {p.thumb ? <img src={p.thumb} alt={p.name} loading="lazy" /> : null}
                      </a>
                      <div class="side-body">
                        <a class="side-name" href={`/san-pham/${p.slug}/`}>{p.name}</a>
                        <div class="side-price">
                          {p.price > 0 ? formatPrice(p.price) : 'Giá liên hệ'}
                          {p.price > 0 && p.old_price > p.price && <del>{formatPrice(p.old_price)}</del>}
                        </div>
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            <section class="side-box" data-viewed hidden>
              <h2>Sản phẩm đã xem</h2>
              <ul class="side-list" data-viewed-list></ul>
            </section>
          </aside>
        </div>
      </>
    ) : (
      <>
        <h1>Không tìm thấy sản phẩm</h1>
        <p>Sản phẩm không tồn tại hoặc đã ngừng kinh doanh. <a href="/">Quay về trang chủ</a>.</p>
      </>
    )}
  </div>

  {product && <script is:inline type="application/json" id="current-product" set:html={currentData}></script>}
  <script is:inline defer src="/gallery.js?v=2"></script>
  <script is:inline defer src="/viewed.js?v=1"></script>
</BaseLayout>