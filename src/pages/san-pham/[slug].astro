---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProductBySlug, getSettings, formatPrice } from '../../lib/db';

const { slug } = Astro.params;
const product = slug ? await getProductBySlug(slug) : null;
const settings = await getSettings();

if (!product) {
  Astro.response.status = 404;
}

const phone = settings.phone || '';
const zalo = settings.zalo || '';
const url = new URL(Astro.url.pathname, Astro.site).toString();

const plainDescription = (product?.description ?? '').replace(/\s+/g, ' ').trim();
const metaDescription = product
  ? plainDescription.slice(0, 155) ||
    `${product.name}. Liên hệ để được tư vấn và báo giá tốt nhất.`
  : 'Sản phẩm không tồn tại hoặc đã ngừng kinh doanh.';

const productSchema = product
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: product.name,
      description: plainDescription || undefined,
      sku: product.sku || undefined,
      image: product.image ? new URL(product.image, Astro.site).toString() : undefined,
      brand: product.brand_name ? { '@type': 'Brand', name: product.brand_name } : undefined,
      offers:
        product.price > 0
          ? {
              '@type': 'Offer',
              url,
              priceCurrency: 'VND',
              price: product.price,
              availability: 'https://schema.org/InStock',
            }
          : undefined,
    }
  : undefined;
---

<BaseLayout
  title={product ? product.name : 'Không tìm thấy sản phẩm'}
  description={metaDescription}
  image={product?.image || undefined}
  noindex={!product}
  wide={true}
  schema={productSchema}
>
  <div class="container page-wide">
    {product ? (
      <article class="product-detail">
        <div class="product-gallery">
          {product.image ? (
            <img src={product.image} alt={product.name} />
          ) : (
            <span>Chưa có ảnh</span>
          )}
        </div>
        <div class="product-info">
          <nav class="breadcrumb" aria-label="Đường dẫn">
            <a href="/">Trang chủ</a>
            {product.category_slug && (
              <>
                {' / '}
                <a href={`/danh-muc/${product.category_slug}/`}>{product.category_name}</a>
              </>
            )}
          </nav>
          <h1>{product.name}</h1>
          {product.brand_name && <p class="meta-line">Thương hiệu: <strong>{product.brand_name}</strong></p>}
          {product.sku && <p class="meta-line">Mã sản phẩm: {product.sku}</p>}
          <p class="price price-lg">
            {product.old_price > product.price && <del>{formatPrice(product.old_price)}</del>}
            {product.price > 0 ? formatPrice(product.price) : 'Liên hệ để biết giá'}
          </p>
          <div class="actions">
            {phone && <a class="btn" href={`tel:${phone.replace(/\s/g, '')}`}>Gọi {phone}</a>}
            {zalo && (
              <a class="btn btn-outline" href={`https://zalo.me/${zalo.replace(/\s/g, '')}`} rel="noopener" target="_blank">
                Nhắn Zalo
              </a>
            )}
          </div>
          {product.description && <div class="product-desc">{product.description}</div>}
        </div>
      </article>
    ) : (
      <>
        <h1>Không tìm thấy sản phẩm</h1>
        <p>Sản phẩm không tồn tại hoặc đã ngừng kinh doanh. <a href="/">Quay về trang chủ</a>.</p>
      </>
    )}
  </div>
</BaseLayout>