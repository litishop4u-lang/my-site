---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSettings } from '../lib/db';

const settings = await getSettings();
const phone = settings.phone || '';
const zalo = settings.zalo || '';
const email = settings.email || '';
const address = settings.address || '';
---

<BaseLayout
  title="Liên hệ"
  description="Thông tin liên hệ, địa chỉ và số điện thoại để đặt hàng hoặc được tư vấn nhanh nhất."
>
  <h1>Liên hệ</h1>
  {address && <p>Địa chỉ: {address}</p>}
  {phone && <p>Điện thoại: <a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a></p>}
  {zalo && <p>Zalo: <a href={`https://zalo.me/${zalo.replace(/\s/g, '')}`}>{zalo}</a></p>}
  {email && <p>Email: <a href={`mailto:${email}`}>{email}</a></p>}
</BaseLayout>