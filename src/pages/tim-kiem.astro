---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { searchProducts } from '../lib/search';

const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 60);
const results = q ? await searchProducts(q, 60) : [];
---

<BaseLayout
  title={q ? `Tìm kiếm: ${q}` : 'Tìm kiếm sản phẩm'}
  description="Kết quả tìm kiếm sản phẩm."
  noindex={true}
  wide={true}
>
  <div class="container page-wide">
    <h1 class="page-title">{q ? `Kết quả cho "${q}"` : 'Tìm kiếm sản phẩm'}</h1>

    <form class="search-page-form" action="/tim-kiem/" method="get" role="search">
      <input type="search" name="q" value={q} placeholder="Nhập tên sản phẩm, mã SKU hoặc thương hiệu..." maxlength="60" />
      <button class="btn" type="submit">Tìm</button>
    </form>

    {q && results.length === 0 && (
      <p class="empty-note">Không tìm thấy sản phẩm nào phù hợp. Hãy thử từ khóa khác.</p>
    )}

    {results.length > 0 && (
      <div class="grid-4">
        {results.map((p) => <ProductCard product={p} />)}
      </div>
    )}
  </div>
</BaseLayout>