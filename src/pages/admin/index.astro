---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';

export const prerender = false;

async function count(sql: string): Promise<number> {
  try {
    const row = await env.DB.prepare(sql).first<{ n: number }>();
    return row?.n ?? 0;
  } catch {
    return 0;
  }
}

const [products, categories, brands, stores, unread] = await Promise.all([
  count('SELECT COUNT(*) AS n FROM products'),
  count('SELECT COUNT(*) AS n FROM categories'),
  count('SELECT COUNT(*) AS n FROM brands'),
  count('SELECT COUNT(*) AS n FROM stores'),
  count('SELECT COUNT(*) AS n FROM contact_messages WHERE is_read = 0'),
]);
---

<AdminLayout title="Tổng quan">
  <h1>Tổng quan</h1>
  <div class="adm-cards">
    <div class="adm-card"><div class="num">{products}</div><div class="label">Sản phẩm</div></div>
    <div class="adm-card"><div class="num">{categories}</div><div class="label">Danh mục</div></div>
    <div class="adm-card"><div class="num">{brands}</div><div class="label">Thương hiệu</div></div>
    <div class="adm-card"><div class="num">{stores}</div><div class="label">Cửa hàng</div></div>
    <a class:list={['adm-card', 'adm-card-link', { 'adm-card-alert': unread > 0 }]} href="/admin/lien-he/">
      <div class="num">{unread}</div>
      <div class="label">Tin nhắn chưa đọc</div>
    </a>
  </div>
  <p class="adm-note">Chọn các mục ở thanh menu phía trên để quản lý sản phẩm, danh mục, banner, cửa hàng, tin nhắn và cài đặt.</p>
</AdminLayout>