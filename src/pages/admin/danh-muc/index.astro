---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
import { slugify } from '../../../lib/slug';
import { uniqueTaxSlug } from '../../../lib/admin-taxonomy';
import { orderCategories } from '../../../lib/catalog';

export const prerender = false;

type Row = {
  id: number;
  name: string;
  slug: string;
  sort_order: number;
  show_on_home: number;
  parent_id: number | null;
  product_count: number;
};

async function validParent(parentId: number, selfId: number): Promise<number | null> {
  if (!Number.isInteger(parentId) || parentId <= 0 || parentId === selfId) return null;
  const row = await env.DB.prepare('SELECT id, parent_id FROM categories WHERE id = ?')
    .bind(parentId)
    .first<{ id: number; parent_id: number | null }>();
  if (!row || row.parent_id) return null;
  if (selfId > 0) {
    const kids = await env.DB.prepare('SELECT COUNT(*) AS n FROM categories WHERE parent_id = ?')
      .bind(selfId)
      .first<{ n: number }>();
    if ((kids?.n ?? 0) > 0) return null;
  }
  return parentId;
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const id = Number(form.get('id'));
  const name = String(form.get('name') ?? '').trim();
  const slugInput = String(form.get('slug') ?? '').trim();
  const sortOrder = parseInt(String(form.get('sort_order') ?? '0'), 10) || 0;
  const showOnHome = form.get('show_on_home') ? 1 : 0;
  const parentRaw = Number(form.get('parent_id'));

  if (action === 'add') {
    if (!name) return Astro.redirect('/admin/danh-muc/?msg=empty');
    const slug = await uniqueTaxSlug('categories', slugify(slugInput || name));
    const parent = await validParent(parentRaw, 0);
    await env.DB.prepare(
      'INSERT INTO categories (name, slug, sort_order, show_on_home, parent_id) VALUES (?, ?, ?, ?, ?)',
    )
      .bind(name, slug, sortOrder, showOnHome, parent)
      .run();
  } else if (Number.isInteger(id) && id > 0) {
    if (action === 'update') {
      if (!name) return Astro.redirect('/admin/danh-muc/?msg=empty');
      const slug = await uniqueTaxSlug('categories', slugify(slugInput || name), id);
      const parent = await validParent(parentRaw, id);
      await env.DB.prepare(
        'UPDATE categories SET name = ?, slug = ?, sort_order = ?, show_on_home = ?, parent_id = ? WHERE id = ?',
      )
        .bind(name, slug, sortOrder, showOnHome, parent, id)
        .run();
    } else if (action === 'delete') {
      await env.DB.prepare('UPDATE categories SET parent_id = NULL WHERE parent_id = ?').bind(id).run();
      await env.DB.prepare('DELETE FROM categories WHERE id = ?').bind(id).run();
    }
  }

  return Astro.redirect('/admin/danh-muc/?msg=saved');
}

const msg = Astro.url.searchParams.get('msg');

const { results } = await env.DB.prepare(
  `SELECT c.id, c.name, c.slug, c.sort_order, c.show_on_home, c.parent_id,
          (SELECT COUNT(*) FROM products p WHERE p.category_id = c.id) AS product_count
   FROM categories c
   ORDER BY c.sort_order, c.id`,
).all<Row>();

const rows = orderCategories(results);
const tops = results.filter((r) => !r.parent_id);
const hasChildren = new Set(results.filter((r) => r.parent_id).map((r) => r.parent_id as number));
const nextOrder = results.reduce((max, r) => Math.max(max, r.sort_order), 0) + 1;
---

<AdminLayout title="Danh mục">
  <h1>Danh mục</h1>

  {msg === 'saved' && <div class="adm-flash">Đã lưu.</div>}
  {msg === 'empty' && <div class="adm-error">Vui lòng nhập tên.</div>}

  <p class="adm-hint">
    Có 2 cấp: <strong>danh mục cha</strong> (ví dụ "Xe gấp gọn") và <strong>danh mục con</strong> (ví dụ "Xe điện gấp gọn"). Chọn danh mục cha ở cột "Danh mục cha" để biến một danh mục thành danh mục con.
  </p>

  <form method="post" class="adm-add">
    <input type="hidden" name="action" value="add" />
    <div>
      <label for="new-name">Tên danh mục mới</label>
      <input id="new-name" name="name" type="text" required />
    </div>
    <div>
      <label for="new-parent">Danh mục cha</label>
      <select id="new-parent" name="parent_id">
        <option value="">-- Không có (là danh mục cha) --</option>
        {tops.map((t) => <option value={t.id}>{t.name}</option>)}
      </select>
    </div>
    <div>
      <label for="new-order">Thứ tự</label>
      <input id="new-order" name="sort_order" type="number" value={nextOrder} />
    </div>
    <label class="adm-check"><input type="checkbox" name="show_on_home" checked /> Hiện ở trang chủ</label>
    <button class="adm-btn" type="submit">+ Thêm danh mục</button>
  </form>

  <div class="adm-list">
    <div class="cat-head">
      <span>Tên</span><span>Đường dẫn</span><span>Danh mục cha</span><span>Thứ tự</span><span>Trang chủ</span><span>Sản phẩm</span><span></span>
    </div>
    {rows.length === 0 && <p class="adm-empty">Chưa có danh mục nào.</p>}
    {rows.map((c) => (
      <form method="post" class:list={['cat-row', { child: !!c.parent_id }]}>
        <input type="hidden" name="id" value={c.id} />
        <input name="name" type="text" value={c.name} required />
        <input name="slug" type="text" value={c.slug} />
        <select name="parent_id" disabled={hasChildren.has(c.id)} title={hasChildren.has(c.id) ? 'Danh mục này đã có danh mục con nên không thể làm danh mục con' : ''}>
          <option value="">-- Không có --</option>
          {tops.filter((t) => t.id !== c.id).map((t) => (
            <option value={t.id} selected={c.parent_id === t.id}>{t.name}</option>
          ))}
        </select>
        <input name="sort_order" type="number" value={c.sort_order} />
        {c.parent_id ? (
          <span class="cat-na">theo mục cha</span>
        ) : (
          <label class="adm-check"><input type="checkbox" name="show_on_home" checked={c.show_on_home === 1} /> Hiện</label>
        )}
        <span>{c.product_count}</span>
        <div class="btns">
          <button class="adm-icon-btn" type="submit" name="action" value="update">Lưu</button>
          <button
            class="adm-icon-btn danger"
            type="submit"
            name="action"
            value="delete"
            onclick="return confirm('Xoá danh mục này? Các sản phẩm trong danh mục sẽ chưa có danh mục, các danh mục con (nếu có) sẽ thành danh mục cha.')"
          >Xoá</button>
        </div>
      </form>
    ))}
  </div>
  <p class="adm-note">Đổi "Đường dẫn" sẽ làm link cũ của danh mục không còn truy cập được. Chỉ đổi khi thật cần. Trang chủ chỉ hiện các danh mục cha và gộp cả sản phẩm của danh mục con.</p>
</AdminLayout>