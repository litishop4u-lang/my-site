---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
import { getSettings } from '../../../lib/db';

export const prerender = false;

const NUMBER_FIELDS = [
  'pol_ship_fee',
  'pol_ship_min',
  'pol_ship_max',
  'pol_handling_days',
  'pol_return_days',
] as const;

const TEXT_FIELDS = ['pol_ship_text', 'pol_time_text', 'pol_return_text'] as const;

const DEFAULT_TEXT: Record<string, string> = {
  pol_ship_text:
    'Miễn phí giao hàng nội thành trong phạm vi 10km.\nĐối với các đơn hàng đi tỉnh sẽ tính phí giao hàng, tùy thuộc vào từng địa điểm.',
  pol_time_text: 'Hàng có sẵn: 1-2 ngày.\nHàng order: từ 30-40 ngày.',
  pol_return_text:
    'Đổi trả trong vòng 03 ngày nếu sản phẩm có lỗi nặng về hệ thống thuộc trách nhiệm của nhà sản xuất.\nKhông chấp nhận đổi trả nếu sản phẩm không ưng theo nhu cầu cá nhân của khách hàng.',
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const entries: [string, string][] = [];

  for (const key of NUMBER_FIELDS) {
    const raw = String(form.get(key) ?? '').replace(/[^\d]/g, '').slice(0, 9);
    entries.push([key, raw]);
  }

  for (const key of TEXT_FIELDS) {
    entries.push([key, String(form.get(key) ?? '').trim().slice(0, 2000)]);
  }

  const ret = String(form.get('pol_return') ?? '');
  entries.push(['pol_return', ret === 'finite' || ret === 'none' ? ret : '']);
  const retFee = String(form.get('pol_return_fee') ?? '');
  entries.push(['pol_return_fee', retFee === 'free' || retFee === 'customer' ? retFee : '']);

  await env.DB.batch(
    entries.map(([key, value]) =>
      env.DB.prepare(
        'INSERT INTO settings (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value',
      ).bind(key, value),
    ),
  );

  return Astro.redirect('/admin/chinh-sach/?saved=1');
}

const s = await getSettings();
const saved = Astro.url.searchParams.get('saved');
const textValue = (key: string) => (s[key] !== undefined ? s[key] : DEFAULT_TEXT[key]);
---

<AdminLayout title="Giao hàng & đổi trả">
  <h1>Giao hàng &amp; đổi trả</h1>

  {saved && <div class="adm-flash">Đã lưu.</div>}

  <form method="post" class="pol-form">
    <h2>Nội dung hiển thị trên trang sản phẩm</h2>
    <p class="pol-hint">Khách hàng sẽ thấy các nội dung này trong khung "Giao hàng &amp; đổi trả". Mỗi dòng là một ý.</p>

    <div class="pol-field">
      <label for="pol_ship_text">Phí giao hàng</label>
      <textarea id="pol_ship_text" name="pol_ship_text" rows="3">{textValue('pol_ship_text')}</textarea>
    </div>

    <div class="pol-field">
      <label for="pol_time_text">Thời gian giao hàng</label>
      <textarea id="pol_time_text" name="pol_time_text" rows="3">{textValue('pol_time_text')}</textarea>
    </div>

    <div class="pol-field">
      <label for="pol_return_text">Chính sách đổi trả</label>
      <textarea id="pol_return_text" name="pol_return_text" rows="4">{textValue('pol_return_text')}</textarea>
    </div>

    <h2>Dữ liệu gửi cho Google (không bắt buộc)</h2>
    <p class="pol-hint">
      Mục nào để trống thì không gửi đi. Chỉ nhập phí giao hàng khi mọi đơn đều cùng một mức phí.
      Nếu phí thay đổi theo địa điểm như hiện tại, hãy để trống ô phí giao hàng.
    </p>

    <div class="pol-field">
      <label for="pol_ship_fee">Phí giao hàng cố định (VNĐ). Nhập 0 nếu miễn phí mọi đơn</label>
      <input id="pol_ship_fee" name="pol_ship_fee" type="text" inputmode="numeric" value={s.pol_ship_fee ?? ''} />
    </div>

    <div class="pol-field">
      <label for="pol_handling_days">Số ngày chuẩn bị hàng (không bắt buộc)</label>
      <input id="pol_handling_days" name="pol_handling_days" type="text" inputmode="numeric" value={s.pol_handling_days ?? ''} />
    </div>

    <div class="pol-row">
      <div class="pol-field">
        <label for="pol_ship_min">Thời gian giao hàng có sẵn: từ (ngày)</label>
        <input id="pol_ship_min" name="pol_ship_min" type="text" inputmode="numeric" value={s.pol_ship_min ?? ''} />
      </div>
      <div class="pol-field">
        <label for="pol_ship_max">đến (ngày)</label>
        <input id="pol_ship_max" name="pol_ship_max" type="text" inputmode="numeric" value={s.pol_ship_max ?? ''} />
      </div>
    </div>

    <div class="pol-field">
      <label for="pol_return">Chính sách đổi trả</label>
      <select id="pol_return" name="pol_return">
        <option value="" selected={!s.pol_return}>Chưa khai báo</option>
        <option value="finite" selected={s.pol_return === 'finite'}>Có đổi trả trong một số ngày</option>
        <option value="none" selected={s.pol_return === 'none'}>Không đổi trả</option>
      </select>
    </div>

    <div class="pol-row">
      <div class="pol-field">
        <label for="pol_return_days">Số ngày được đổi trả</label>
        <input id="pol_return_days" name="pol_return_days" type="text" inputmode="numeric" value={s.pol_return_days ?? ''} />
      </div>
      <div class="pol-field">
        <label for="pol_return_fee">Phí gửi trả hàng</label>
        <select id="pol_return_fee" name="pol_return_fee">
          <option value="" selected={!s.pol_return_fee}>Không nêu</option>
          <option value="free" selected={s.pol_return_fee === 'free'}>Cửa hàng chịu</option>
          <option value="customer" selected={s.pol_return_fee === 'customer'}>Khách chịu</option>
        </select>
      </div>
    </div>

    <button class="adm-btn" type="submit">Lưu</button>
  </form>
</AdminLayout>