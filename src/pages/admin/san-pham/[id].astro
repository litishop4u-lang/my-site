---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProductForm from '../../../components/ProductForm.astro';
import { getCategories } from '../../../lib/db';
import {
  getBrands,
  getProductById,
  parseProductForm,
  updateProduct,
  uniqueSlug,
} from '../../../lib/admin-products';

export const prerender = false;

const id = Number(Astro.params.id);
const existing = Number.isInteger(id) && id > 0 ? await getProductById(id) : null;

if (!existing) {
  return Astro.redirect('/admin/san-pham/');
}

const [categories, brands] = await Promise.all([getCategories(), getBrands()]);

let product = existing;
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const parsed = parseProductForm(form);
  product = { ...parsed, id };

  if (!parsed.name) {
    error = 'Vui lòng nhập tên sản phẩm.';
  } else {
    parsed.slug = await uniqueSlug(parsed.slug, id);
    await updateProduct(id, parsed);
    return Astro.redirect('/admin/san-pham/?saved=1');
  }
}
---

<AdminLayout title="Sửa sản phẩm">
  <h1>Sửa sản phẩm</h1>
  <ProductForm product={product} categories={categories} brands={brands} error={error} submitLabel="Lưu thay đổi" />
</AdminLayout>