---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
import { slugify } from '../../../lib/slug';
import { uniqueTaxSlug } from '../../../lib/admin-taxonomy';

export const prerender = false;

type Row = {
  id: number;
  name: string;
  slug: string;
  product_count: number;
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const id = Number(form.get('id'));
  const name = String(form.get('name') ?? '').trim();
  const slugInput = String(form.get('slug') ?? '').trim();

  if (action === 'add') {
    if (!name) return Astro.redirect('/admin/thuong-hieu/?msg=empty');
    const slug = await uniqueTaxSlug('brands', slugify(slugInput || name));
    await env.DB.prepare('INSERT INTO brands (name, slug) VALUES (?, ?)').bind(name, slug).run();
  } else if (Number.isInteger(id) && id > 0) {
    if (action === 'update') {
      if (!name) return Astro.redirect('/admin/thuong-hieu/?msg=empty');
      const slug = await uniqueTaxSlug('brands', slugify(slugInput || name), id);
      await env.DB.prepare('UPDATE brands SET name = ?, slug = ? WHERE id = ?')
        .bind(name, slug, id)
        .run();
    } else if (action === 'delete') {
      await env.DB.prepare('DELETE FROM brands WHERE id = ?').bind(id).run();
    }
  }

  return Astro.redirect('/admin/thuong-hieu/?msg=saved');
}

const msg = Astro.url.searchParams.get('msg');

const { results } = await env.DB.prepare(
  `SELECT b.id, b.name, b.slug,
          (SELECT COUNT(*) FROM products p WHERE p.brand_id = b.id) AS product_count
   FROM brands b
   ORDER BY b.name`,
).all<Row>();
---

<AdminLayout title="Thương hiệu">
  <h1>Thương hiệu</h1>

  {msg === 'saved' && <div class="adm-flash">Đã lưu.</div>}
  {msg === 'empty' && <div class="adm-error">Vui lòng nhập tên.</div>}

  <form method="post" class="adm-add">
    <input type="hidden" name="action" value="add" />
    <div>
      <label for="new-name">Tên thương hiệu mới</label>
      <input id="new-name" name="name" type="text" required />
    </div>
    <button class="adm-btn" type="submit">+ Thêm thương hiệu</button>
  </form>

  <div class="adm-list">
    <div class="adm-rowform adm-rowform-brand head">
      <span>Tên</span><span>Đường dẫn</span><span>Sản phẩm</span><span></span>
    </div>
    {results.length === 0 && <p class="adm-empty">Chưa có thương hiệu nào.</p>}
    {results.map((b) => (
      <form method="post" class="adm-rowform adm-rowform-brand">
        <input type="hidden" name="id" value={b.id} />
        <input name="name" type="text" value={b.name} required />
        <input name="slug" type="text" value={b.slug} />
        <span>{b.product_count}</span>
        <div class="btns">
          <button class="adm-icon-btn" type="submit" name="action" value="update">Lưu</button>
          <button
            class="adm-icon-btn danger"
            type="submit"
            name="action"
            value="delete"
            onclick="return confirm('Xoá thương hiệu này? Các sản phẩm của thương hiệu sẽ chưa có thương hiệu.')"
          >Xoá</button>
        </div>
      </form>
    ))}
  </div>
</AdminLayout>