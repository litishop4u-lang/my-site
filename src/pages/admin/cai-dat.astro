---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ImageField from '../../components/ImageField.astro';
import { env } from 'cloudflare:workers';
import { getSettings } from '../../lib/db';

export const prerender = false;

const TEXT_FIELDS = [
  'site_name',
  'phone',
  'zalo',
  'email',
  'address',
  'hero_title',
  'hero_subtitle',
  'hero_text',
  'store_name',
  'map_embed',
  'policies',
  'messenger',
  'work_hours',
] as const;
const IMAGE_FIELDS = ['logo', 'hero_image'] as const;
const MEDIA_PATTERN = /^\/media\/\?k=[a-z0-9\-/]+\.(jpg|png|webp|gif)$/;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const entries: [string, string][] = [];

  for (const key of TEXT_FIELDS) {
    entries.push([key, String(form.get(key) ?? '').trim().slice(0, 3000)]);
  }
  for (const key of IMAGE_FIELDS) {
    const value = String(form.get(key) ?? '').trim();
    entries.push([key, MEDIA_PATTERN.test(value) ? value : '']);
  }

  await env.DB.batch(
    entries.map(([key, value]) =>
      env.DB.prepare(
        'INSERT INTO settings (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value',
      ).bind(key, value),
    ),
  );

  return Astro.redirect('/admin/cai-dat/?saved=1');
}

const s = await getSettings();
const saved = Astro.url.searchParams.get('saved');
---

<AdminLayout title="Cài đặt website">
  <h1>Cài đặt website</h1>
  {saved && <div class="adm-flash">Đã lưu cài đặt.</div>}

  <form method="post" class="adm-form">
    <div class="adm-form-grid">
      <div class="adm-field adm-span2">
        <label for="site_name">Tên cửa hàng / thương hiệu</label>
        <input id="site_name" name="site_name" type="text" value={s.site_name ?? ''} />
      </div>

      <ImageField
        name="logo"
        label="Logo (hiện ở đầu trang trên nền xanh đậm)"
        value={s.logo ?? ''}
        maxSize={800}
        hint="480 × 150 px (tỉ lệ 3,2:1), PNG hoặc WebP nền trong suốt, chữ và hình màu sáng."
      />

      <div class="adm-field">
        <label for="phone">Số điện thoại</label>
        <input id="phone" name="phone" type="text" value={s.phone ?? ''} />
      </div>

      <div class="adm-field">
        <label for="zalo">Số Zalo</label>
        <input id="zalo" name="zalo" type="text" value={s.zalo ?? ''} />
      </div>

      <div class="adm-field">
        <label for="email">Email</label>
        <input id="email" name="email" type="text" value={s.email ?? ''} />
      </div>

      <div class="adm-field">
        <label for="address">Địa chỉ</label>
        <input id="address" name="address" type="text" value={s.address ?? ''} />
      </div>

            <div class="adm-field">
        <label for="store_name">Tên cửa hàng / chi nhánh (hiện ở mục Địa chỉ cửa hàng)</label>
        <input id="store_name" name="store_name" type="text" placeholder="vd: Quận 5" value={s.store_name ?? ''} />
      </div>

      <div class="adm-field adm-span2">
        <label for="map_embed">Bản đồ Google Maps (không bắt buộc)</label>
        <textarea id="map_embed" name="map_embed" rows="3" placeholder="Dán mã nhúng của Google Maps vào đây. Để trống thì bản đồ tự lấy theo Địa chỉ ở trên.">{s.map_embed ?? ''}</textarea>
        <div class="adm-size">
          <strong>Cách lấy:</strong> mở Google Maps, tìm đúng vị trí cửa hàng, bấm <strong>Chia sẻ</strong>, chọn tab <strong>Nhúng bản đồ</strong>, bấm <strong>Sao chép HTML</strong> rồi dán vào ô này. Nếu để trống, bản đồ sẽ tìm theo chữ trong ô Địa chỉ.
        </div>
      </div>

      <div class="adm-field adm-span2">
        <label for="policies">Chính sách bán hàng (mỗi dòng là một ý)</label>
        <textarea id="policies" name="policies" rows="6" placeholder="Miễn phí giao hàng trong bán kính 15km&#10;Hỗ trợ kĩ thuật suốt quá trình sử dụng&#10;Cam kết chính hãng 100%">{s.policies ?? ''}</textarea>
      </div>

            <div class="adm-field">
        <label for="messenger">Facebook Messenger (tên trang hoặc đường dẫn m.me)</label>
        <input id="messenger" name="messenger" type="text" placeholder="vd: lkebike hoặc https://m.me/lkebike" value={s.messenger ?? ''} />
      </div>

      <div class="adm-field">
        <label for="work_hours">Giờ làm việc (hiện ở nút liên hệ nổi)</label>
        <input id="work_hours" name="work_hours" type="text" placeholder="8:30 - 20:00" value={s.work_hours ?? ''} />
      </div>

      <div class="adm-field adm-span2">
        <label for="hero_title">Tiêu đề trang chủ (thẻ H1, hiện dưới banner)</label>
        <input id="hero_title" name="hero_title" type="text" value={s.hero_title ?? ''} />
      </div>

      <div class="adm-field adm-span2">
        <label for="hero_subtitle">Dòng phụ (nên chứa từ khóa chính)</label>
        <input id="hero_subtitle" name="hero_subtitle" type="text" value={s.hero_subtitle ?? ''} />
      </div>

      <div class="adm-field adm-span2">
        <label for="hero_text">Đoạn giới thiệu (cũng là mô tả hiện trên Google)</label>
        <textarea id="hero_text" name="hero_text" rows="3">{s.hero_text ?? ''}</textarea>
      </div>

      <ImageField
        name="hero_image"
        label="Ảnh nền banner dự phòng (chỉ dùng khi chưa có banner nào ở mục Banner)"
        value={s.hero_image ?? ''}
        maxSize={2000}
        hint="1920 × 600 px (tỉ lệ 16:5), JPG hoặc WebP, dưới khoảng 300 KB."
      />
    </div>

    <div class="adm-actions">
      <button id="submit-btn" class="adm-btn" type="submit">Lưu cài đặt</button>
    </div>
  </form>

  <script is:inline defer src="/admin-image-field.js?v=1"></script>
</AdminLayout>