---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { getSettings } from '../../lib/db';

export const prerender = false;

const { slug } = Astro.params;
const post = slug ? await getEntry('blog', slug) : undefined;
const settings = await getSettings();

if (!post) {
  Astro.response.status = 404;
}

const { Content } = post ? await render(post) : { Content: null };
const url = new URL(Astro.url.pathname, Astro.site).toString();

const articleSchema = post
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.pubDate.toISOString(),
      dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
      mainEntityOfPage: url,
      image: post.data.image ? new URL(post.data.image, Astro.site).toString() : undefined,
      author: { '@type': 'Organization', name: settings.site_name || 'Tên Website' },
    }
  : undefined;
---

<BaseLayout
  title={post ? post.data.title : 'Không tìm thấy bài viết'}
  description={post ? post.data.description : 'Bài viết không tồn tại hoặc đã bị xoá.'}
  image={post?.data.image}
  type={post ? 'article' : 'website'}
  noindex={!post}
  publishedTime={post?.data.pubDate}
  modifiedTime={post?.data.updatedDate}
  schema={articleSchema}
>
  {post && Content ? (
    <article>
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        Đăng ngày {post.data.pubDate.toLocaleDateString('vi-VN')}
      </div>
      <Content />
    </article>
  ) : (
    <>
      <h1>Không tìm thấy bài viết</h1>
      <p><a href="/blog/">Quay lại tin tức</a></p>
    </>
  )}
</BaseLayout>