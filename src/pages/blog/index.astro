---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listPosts, formatDate } from '../../lib/posts';

export const prerender = false;

const posts = await listPosts(100);
---

<BaseLayout
  title="Tin tức"
  description="Tổng hợp các bài viết, tin tức và hướng dẫn mới nhất."
  wide={true}
>
  <div class="container page-wide">
    <h1 class="page-title">Tin tức</h1>

    {posts.length === 0 ? (
      <p class="empty-note">Chưa có bài viết nào.</p>
    ) : (
      <div class="grid-3">
        {posts.map((post) => (
          <article class="news-card">
            <a class="thumb" href={`/blog/${post.slug}/`}>
              {post.image ? <img src={post.image} alt={post.title} loading="lazy" /> : null}
            </a>
            <div class="body">
              <h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
              <div class="post-meta">{formatDate(post.pub_date)}</div>
              {post.description && <p>{post.description}</p>}
              <a class="link-more" href={`/blog/${post.slug}/`}>Xem thêm</a>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</BaseLayout>