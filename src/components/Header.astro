---
import type { Settings, Category } from '../lib/db';

interface Props {
  settings: Settings;
  categories?: Category[];
}

const { settings, categories = [] } = Astro.props;
const path = Astro.url.pathname;
const topCategories = categories.filter((c) => !c.parent_id);
const childrenOf = (id: number) => categories.filter((c) => c.parent_id === id);
const siteName = settings.site_name || 'Tên Website';
const phone = settings.phone || '';

const isHome = path === '/';
const isAbout = path.startsWith('/gioi-thieu/');
const isBlog = path.startsWith('/blog/');
const isContact = path.startsWith('/lien-he/');
const isShop = path.startsWith('/danh-muc/') || path.startsWith('/san-pham/');
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      {settings.logo ? <img src={settings.logo} alt={siteName} /> : siteName}
    </a>

    <nav class="main-nav" aria-label="Menu chính">
      <a href="/" aria-current={isHome ? 'page' : undefined}>Trang chủ</a>
      <a href="/gioi-thieu/" aria-current={isAbout ? 'page' : undefined}>Giới thiệu</a>

      {categories.length > 0 && (
        <div class="nav-dropdown" data-dropdown>
          <button
            type="button"
            class:list={['nav-toggle', { active: isShop }]}
            aria-expanded="false"
            aria-haspopup="true"
            data-dropdown-toggle
          >
            Sản phẩm <span class="caret" aria-hidden="true">▾</span>
          </button>
          <ul class="dropdown-menu">
            {topCategories.map((c) => {
              const kids = childrenOf(c.id);
              return (
                <li class="dd-group">
                  <a class="dd-parent" href={`/danh-muc/${c.slug}/`}>{c.name}</a>
                  {kids.length > 0 && (
                    <ul class="dd-children">
                      {kids.map((k) => (
                        <li><a href={`/danh-muc/${k.slug}/`}>{k.name}</a></li>
                      ))}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      )}

      <a href="/blog/" aria-current={isBlog ? 'page' : undefined}>Tin tức</a>
      <a href="/lien-he/" aria-current={isContact ? 'page' : undefined}>Liên hệ</a>
    </nav>

        <div class="header-search" data-search>
      <form action="/tim-kiem/" method="get" role="search" autocomplete="off">
        <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
        <input type="search" name="q" placeholder="Tìm sản phẩm..." aria-label="Tìm sản phẩm" maxlength="60" />
      </form>
      <div class="search-results" data-search-results hidden></div>
    </div>
    <script is:inline defer src="/search.js?v=1"></script>

    {phone && <a class="header-phone" href={`tel:${phone.replace(/\s/g, '')}`}>Hotline : {phone}</a>}
  </div>
</header>

<script is:inline>
  (function () {
    var dd = document.querySelector('[data-dropdown]');
    if (!dd) return;
    var btn = dd.querySelector('[data-dropdown-toggle]');

    function setOpen(open) {
      dd.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      setOpen(!dd.classList.contains('open'));
    });
    document.addEventListener('click', function (e) {
      if (!dd.contains(e.target)) setOpen(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });
  })();
</script>