---
import type { Settings, Category } from '../lib/db';

interface Props {
  settings: Settings;
  categories: Category[];
}

const { settings, categories } = Astro.props;
const year = new Date().getFullYear();
const siteName = settings.site_name || 'Tên Website';
const phone = settings.phone || '';
const zalo = settings.zalo || '';
const email = settings.email || '';
const address = settings.address || '';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand">{siteName}</p>
      {address && <p>Địa chỉ: {address}</p>}
      {phone && <p>Điện thoại: <a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a></p>}
      {email && <p>Email: <a href={`mailto:${email}`}>{email}</a></p>}
    </div>
    <div>
      <h4>Menu</h4>
      <ul>
        <li><a href="/">Trang chủ</a></li>
        <li><a href="/gioi-thieu/">Giới thiệu</a></li>
        <li><a href="/blog/">Tin tức</a></li>
        <li><a href="/lien-he/">Liên hệ</a></li>
      </ul>
    </div>
    <div>
      <h4>Danh mục</h4>
      <ul>
        {categories.map((c) => (
          <li><a href={`/danh-muc/${c.slug}/`}>{c.name}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h4>Kết nối</h4>
      <ul>
        {zalo && (
          <li><a href={`https://zalo.me/${zalo.replace(/\s/g, '')}`} rel="noopener" target="_blank">Zalo</a></li>
        )}
        <li><a href="https://facebook.com/" rel="noopener" target="_blank">Facebook</a></li>
        <li><a href="https://youtube.com/" rel="noopener" target="_blank">YouTube</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; {year} {siteName}. Bảo lưu mọi quyền.</p>
  </div>
</footer>