---
import type { Category } from '../lib/db';
import type { Brand, ProductInput } from '../lib/admin-products';
import { descriptionForEditor } from '../lib/rich';
import { orderCategories } from '../lib/catalog';

interface Props {
  product: ProductInput;
  categories: Category[];
  brands: Brand[];
  error?: string;
  submitLabel: string;
}

const { product, categories, brands, error = '', submitLabel } = Astro.props;
const money = (n: number) => (n > 0 ? n.toLocaleString('vi-VN') : '');

const editorHtml = await descriptionForEditor(product.description);
const initialData = JSON.stringify({
  images: product.images,
  specs: product.specs,
  html: editorHtml,
}).replace(/</g, '\\u003c');
---

<form method="post" class="adm-form" id="product-form">
  {error && <div class="adm-error">{error}</div>}

  <div class="adm-form-grid">
    <div class="adm-field adm-span2">
      <label for="name">Tên sản phẩm *</label>
      <input id="name" name="name" type="text" required value={product.name} />
    </div>

    <div class="adm-field">
      <label for="sku">Mã SKU</label>
      <input id="sku" name="sku" type="text" value={product.sku} />
    </div>

    <div class="adm-field">
      <label for="category_id">Danh mục</label>
      <div class="adm-select-row">
        <select id="category_id" name="category_id">
          <option value="">-- Chọn danh mục --</option>
          {orderCategories(categories).map((c) => (
            <option value={c.id} selected={product.category_id === c.id}>{c.parent_id ? '— ' : ''}{c.name}</option>
          ))}
        </select>
        <button type="button" class="adm-plus" data-add-tax="category" title="Thêm danh mục mới" aria-label="Thêm danh mục mới">+</button>
      </div>
    </div>

    <div class="adm-field">
      <label for="brand_id">Thương hiệu</label>
      <div class="adm-select-row">
        <select id="brand_id" name="brand_id">
          <option value="">-- Chọn thương hiệu --</option>
          {brands.map((b) => (
            <option value={b.id} selected={product.brand_id === b.id}>{b.name}</option>
          ))}
        </select>
        <button type="button" class="adm-plus" data-add-tax="brand" title="Thêm thương hiệu mới" aria-label="Thêm thương hiệu mới">+</button>
      </div>
    </div>

    <div class="adm-field">
      <label for="price">Giá bán (đ)</label>
      <input id="price" name="price" type="text" inputmode="numeric" data-money value={money(product.price)} />
    </div>

    <div class="adm-field">
      <label for="old_price">Giá cũ - gạch ngang (đ, không bắt buộc)</label>
      <input id="old_price" name="old_price" type="text" inputmode="numeric" data-money value={money(product.old_price)} />
    </div>

    <div class="adm-field adm-span2">
      <label>Ảnh sản phẩm</label>
      <p class="adm-hint">
        Chọn được nhiều ảnh cùng lúc (tối đa 20). Ảnh đầu tiên là ảnh đại diện, ảnh thứ hai hiện ra khi khách rê chuột vào sản phẩm. Dùng nút ‹ › để đổi thứ tự. Nên dùng các ảnh cùng tỉ lệ để khung ảnh hiển thị đẹp nhất.
      </p>
      <div id="pf-gallery" class="pf-gallery"></div>
      <input id="pf-image-files" type="file" accept="image/*" multiple />
      <div class="adm-size">
        <strong>Kích thước chuẩn:</strong> 1200 × 1200 px (ảnh vuông 1:1) hoặc 1200 × 900 px (4:3), định dạng JPG/PNG/WebP. Các ảnh trong cùng một sản phẩm nên cùng tỉ lệ. Ảnh lớn hơn sẽ được tự thu nhỏ.
      </div>
      <div class="pf-actions">
        <button id="pf-pick-library" class="adm-icon-btn" type="button">Chọn từ thư viện ảnh đã tải lên</button>
      </div>
    </div>

    <div class="adm-field adm-span2">
      <label>Thông số kỹ thuật</label>
      <p class="adm-hint">Dòng nào để trống phần giá trị sẽ không hiện trên website.</p>
      <div id="pf-specs" class="pf-specs"></div>
      <button id="pf-add-spec" class="adm-icon-btn" type="button">+ Thêm dòng thông số</button>
    </div>

    <div class="adm-field adm-span2">
      <label>Mô tả sản phẩm</label>
      <p class="adm-hint">
        Đặt con trỏ vào chỗ muốn chèn rồi bấm Chèn ảnh / YouTube / video, chúng sẽ nằm đúng vị trí đó trong bài. Bấm vào một ảnh hoặc video để đổi cỡ hoặc xoá. Video từ máy tối đa 50 MB (nên dùng MP4). Ảnh dán từ trang web khác sẽ không được giữ, hãy dùng nút Chèn ảnh.
      </p>

      <div class="ed">
        <div class="ed-toolbar" id="ed-toolbar">
          <select id="ed-block" title="Kiểu đoạn">
            <option value="">Kiểu đoạn</option>
            <option value="p">Đoạn văn</option>
            <option value="h2">Tiêu đề lớn</option>
            <option value="h3">Tiêu đề vừa</option>
            <option value="h4">Tiêu đề nhỏ</option>
            <option value="blockquote">Trích dẫn</option>
          </select>
          <select id="ed-font" title="Phông chữ">
            <option value="">Phông chữ</option>
            <option value="Arial, Helvetica, sans-serif">Arial</option>
            <option value="Tahoma, Geneva, sans-serif">Tahoma</option>
            <option value="Verdana, Geneva, sans-serif">Verdana</option>
            <option value="'Trebuchet MS', sans-serif">Trebuchet MS</option>
            <option value="'Segoe UI', sans-serif">Segoe UI</option>
            <option value="'Times New Roman', Times, serif">Times New Roman</option>
            <option value="Georgia, serif">Georgia</option>
            <option value="'Courier New', monospace">Courier New</option>
          </select>
          <select id="ed-size" title="Cỡ chữ (bôi đen chữ trước)">
            <option value="">Cỡ chữ</option>
            <option value="12">12</option>
            <option value="14">14</option>
            <option value="16">16</option>
            <option value="18">18</option>
            <option value="20">20</option>
            <option value="24">24</option>
            <option value="28">28</option>
            <option value="32">32</option>
            <option value="36">36</option>
            <option value="48">48</option>
          </select>
          <span class="ed-sep"></span>
          <button type="button" data-cmd="bold" title="In đậm"><b>B</b></button>
          <button type="button" data-cmd="italic" title="In nghiêng"><i>I</i></button>
          <button type="button" data-cmd="underline" title="Gạch chân"><u>U</u></button>
          <button type="button" data-cmd="strikeThrough" title="Gạch ngang"><s>S</s></button>
          <input id="ed-color" type="color" value="#000000" title="Màu chữ" />
          <span class="ed-sep"></span>
          <button type="button" data-cmd="justifyLeft" title="Căn trái">Trái</button>
          <button type="button" data-cmd="justifyCenter" title="Căn giữa">Giữa</button>
          <button type="button" data-cmd="justifyRight" title="Căn phải">Phải</button>
          <button type="button" data-cmd="justifyFull" title="Căn đều hai bên">Đều</button>
          <span class="ed-sep"></span>
          <button type="button" data-cmd="insertUnorderedList" title="Danh sách chấm">• Danh sách</button>
          <button type="button" data-cmd="insertOrderedList" title="Danh sách số">1. Danh sách</button>
          <button type="button" id="ed-link" title="Chèn liên kết">Liên kết</button>
          <button type="button" data-cmd="unlink" title="Bỏ liên kết">Bỏ liên kết</button>
          <button type="button" data-cmd="removeFormat" title="Xoá định dạng">Xoá định dạng</button>
          <span class="ed-sep"></span>
          <button type="button" id="ed-ai" class="ed-ai" title="AI soạn mô tả giúp bạn">✨ AI viết giúp</button>
          <span class="ed-sep"></span>
          <button type="button" id="ed-img" title="Chèn ảnh tại vị trí con trỏ">+ Ảnh</button>
          <button type="button" id="ed-yt" title="Chèn video YouTube">+ YouTube</button>
          <button type="button" id="ed-video" title="Chèn video từ máy">+ Video</button>
          <span class="ed-sep"></span>
          <button type="button" data-cmd="undo" title="Hoàn tác">↶</button>
          <button type="button" data-cmd="redo" title="Làm lại">↷</button>
        </div>

        <div class="ed-media-bar" id="ed-media-bar" hidden>
          <span>Ảnh/video đang chọn:</span>
          <button type="button" data-size="s">Nhỏ 50%</button>
          <button type="button" data-size="m">Vừa 75%</button>
          <button type="button" data-size="l">Rộng 100%</button>
          <button type="button" id="ed-media-del" class="danger">Xoá</button>
        </div>

        <div id="ed-area" class="ed-area" contenteditable="true"></div>
      </div>

      <input id="ed-file-images" type="file" accept="image/*" multiple hidden />
      <input id="ed-file-video" type="file" accept="video/mp4,video/webm" hidden />
    </div>

    <div class="adm-field adm-span2">
      <label class="adm-check">
        <input name="is_active" type="checkbox" checked={product.is_active === 1} />
        Hiển thị trên website
      </label>
    </div>
  </div>

  <input type="hidden" name="images" id="pf-images-input" />
  <input type="hidden" name="specs" id="pf-specs-input" />
  <input type="hidden" name="description" id="pf-desc-input" />

  <div id="pf-status" class="adm-hint"></div>

  <div class="adm-actions">
    <button id="submit-btn" class="adm-btn" type="submit">{submitLabel}</button>
    <a class="adm-link" href="/admin/san-pham/">Huỷ</a>
  </div>
</form>

<script is:inline type="application/json" id="pf-data" set:html={initialData}></script>
<script is:inline defer src="/admin-product-form.js?v=1"></script>