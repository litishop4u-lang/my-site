---
import type { Category } from '../lib/db';
import type { Brand, ProductInput } from '../lib/admin-products';
import { parseBlocks } from '../lib/content';

interface Props {
  product: ProductInput;
  categories: Category[];
  brands: Brand[];
  error?: string;
  submitLabel: string;
}

const { product, categories, brands, error = '', submitLabel } = Astro.props;
const money = (n: number) => (n > 0 ? n.toLocaleString('vi-VN') : '');

const initialData = JSON.stringify({
  images: product.images,
  specs: product.specs,
  blocks: parseBlocks(product.description),
}).replace(/</g, '\\u003c');
---

<form method="post" class="adm-form" id="product-form">
  {error && <div class="adm-error">{error}</div>}

  <div class="adm-form-grid">
    <div class="adm-field adm-span2">
      <label for="name">Tên sản phẩm *</label>
      <input id="name" name="name" type="text" required value={product.name} />
    </div>

    <div class="adm-field">
      <label for="sku">Mã SKU</label>
      <input id="sku" name="sku" type="text" value={product.sku} />
    </div>

    <div class="adm-field">
      <label for="slug">Đường dẫn (để trống sẽ tự tạo từ tên)</label>
      <input id="slug" name="slug" type="text" value={product.slug} />
    </div>

    <div class="adm-field">
      <label for="category_id">Danh mục</label>
      <select id="category_id" name="category_id">
        <option value="">-- Chọn danh mục --</option>
        {categories.map((c) => (
          <option value={c.id} selected={product.category_id === c.id}>{c.name}</option>
        ))}
      </select>
    </div>

    <div class="adm-field">
      <label for="brand_id">Thương hiệu</label>
      <select id="brand_id" name="brand_id">
        <option value="">-- Chọn thương hiệu --</option>
        {brands.map((b) => (
          <option value={b.id} selected={product.brand_id === b.id}>{b.name}</option>
        ))}
      </select>
    </div>

    <div class="adm-field">
      <label for="price">Giá bán (đ)</label>
      <input id="price" name="price" type="text" inputmode="numeric" data-money value={money(product.price)} />
    </div>

    <div class="adm-field">
      <label for="old_price">Giá cũ - gạch ngang (đ, không bắt buộc)</label>
      <input id="old_price" name="old_price" type="text" inputmode="numeric" data-money value={money(product.old_price)} />
    </div>

    <div class="adm-field adm-span2">
      <label>Ảnh sản phẩm</label>
      <p class="adm-hint">
        Chọn được nhiều ảnh cùng lúc (tối đa 20). Ảnh đầu tiên là ảnh đại diện, ảnh thứ hai hiện ra khi khách rê chuột vào sản phẩm. Dùng nút ‹ › để đổi thứ tự.
      </p>
      <div id="pf-gallery" class="pf-gallery"></div>
      <input id="pf-image-files" type="file" accept="image/*" multiple />
    </div>

    <div class="adm-field adm-span2">
      <label>Thông số kỹ thuật</label>
      <p class="adm-hint">Dòng nào để trống phần giá trị sẽ không hiện trên website.</p>
      <div id="pf-specs" class="pf-specs"></div>
      <button id="pf-add-spec" class="adm-icon-btn" type="button">+ Thêm dòng thông số</button>
    </div>

    <div class="adm-field adm-span2">
      <label>Mô tả sản phẩm</label>
      <p class="adm-hint">
        Hiện ở cuối trang sản phẩm. Thêm lần lượt các phần bên dưới, dùng nút ↑ ↓ để đổi vị trí. Video từ máy tối đa 50 MB (nên dùng MP4); video dài hơn hãy đăng lên YouTube rồi dán đường dẫn.
      </p>
      <div id="pf-blocks" class="pf-blocks"></div>
      <div class="pf-toolbar">
        <button type="button" class="adm-icon-btn" data-add="heading">+ Tiêu đề</button>
        <button type="button" class="adm-icon-btn" data-add="text">+ Đoạn văn</button>
        <button type="button" class="adm-icon-btn" data-add="image">+ Ảnh</button>
        <button type="button" class="adm-icon-btn" data-add="youtube">+ Video YouTube</button>
        <button type="button" class="adm-icon-btn" data-add="video">+ Video từ máy</button>
      </div>
      <input id="pf-block-images" type="file" accept="image/*" multiple hidden />
      <input id="pf-block-video" type="file" accept="video/mp4,video/webm" hidden />
    </div>

    <div class="adm-field adm-span2">
      <label class="adm-check">
        <input name="is_active" type="checkbox" checked={product.is_active === 1} />
        Hiển thị trên website
      </label>
    </div>
  </div>

  <input type="hidden" name="images" id="pf-images-input" />
  <input type="hidden" name="specs" id="pf-specs-input" />
  <input type="hidden" name="description" id="pf-desc-input" />

  <div id="pf-status" class="adm-hint"></div>

  <div class="adm-actions">
    <button id="submit-btn" class="adm-btn" type="submit">{submitLabel}</button>
    <a class="adm-link" href="/admin/san-pham/">Huỷ</a>
  </div>
</form>

<script is:inline type="application/json" id="pf-data" set:html={initialData}></script>

<script is:inline>
  (() => {
    const dataEl = document.getElementById('pf-data');
    let initial = {};
    try {
      initial = JSON.parse(dataEl.textContent || '{}');
    } catch (e) {
      initial = {};
    }

    const state = {
      images: Array.isArray(initial.images) ? [...initial.images] : [],
      specs: (Array.isArray(initial.specs) ? initial.specs : []).map((s) => ({
        label: s.label || '',
        value: s.value || '',
      })),
      blocks: (Array.isArray(initial.blocks) ? initial.blocks : []).map((b) => ({ ...b })),
    };

    const MAX_IMAGES = 20;
    const form = document.getElementById('product-form');
    const submitBtn = document.getElementById('submit-btn');
    const statusEl = document.getElementById('pf-status');
    const galleryEl = document.getElementById('pf-gallery');
    const specsEl = document.getElementById('pf-specs');
    const blocksEl = document.getElementById('pf-blocks');
    const blockImages = document.getElementById('pf-block-images');
    const blockVideo = document.getElementById('pf-block-video');
    let busy = 0;

    function h(tag, props, ...kids) {
      const node = document.createElement(tag);
      for (const key in props || {}) {
        const value = props[key];
        if (value === false || value == null) continue;
        if (key === 'class') node.className = value;
        else if (key === 'text') node.textContent = value;
        else if (key.startsWith('on')) node.addEventListener(key.slice(2), value);
        else node.setAttribute(key, value === true ? '' : String(value));
      }
      for (const kid of kids) {
        if (kid) node.append(kid);
      }
      return node;
    }

    function setStatus(text) {
      statusEl.textContent = text;
    }

    async function withBusy(fn) {
      busy++;
      submitBtn.disabled = true;
      try {
        return await fn();
      } finally {
        busy--;
        if (busy === 0) submitBtn.disabled = false;
      }
    }

    function swap(list, i, j) {
      if (j < 0 || j >= list.length) return;
      const t = list[i];
      list[i] = list[j];
      list[j] = t;
    }

    function ytId(input) {
      const value = String(input).trim();
      if (/^[A-Za-z0-9_-]{11}$/.test(value)) return value;
      try {
        const url = new URL(value);
        const host = url.hostname.replace(/^www\./, '').replace(/^m\./, '');
        let id = null;
        if (host === 'youtu.be') {
          id = url.pathname.slice(1).split('/')[0];
        } else if (host === 'youtube.com' || host === 'youtube-nocookie.com') {
          if (url.pathname === '/watch') {
            id = url.searchParams.get('v');
          } else {
            const m = url.pathname.match(/^\/(embed|shorts|live|v)\/([A-Za-z0-9_-]{11})/);
            if (m) id = m[2];
          }
        }
        return id && /^[A-Za-z0-9_-]{11}$/.test(id) ? id : null;
      } catch (e) {
        return null;
      }
    }

    async function compress(file, maxSize) {
      if (file.type === 'image/gif') return file;
      try {
        const bitmap = await createImageBitmap(file);
        const scale = Math.min(1, maxSize / Math.max(bitmap.width, bitmap.height));
        const w = Math.round(bitmap.width * scale);
        const hgt = Math.round(bitmap.height * scale);
        const canvas = document.createElement('canvas');
        canvas.width = w;
        canvas.height = hgt;
        canvas.getContext('2d').drawImage(bitmap, 0, 0, w, hgt);
        const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/webp', 0.85));
        if (!blob) return file;
        return new File([blob], 'image.webp', { type: 'image/webp' });
      } catch (e) {
        return file;
      }
    }

    async function uploadImage(file) {
      const small = await compress(file, 1600);
      const data = new FormData();
      data.append('file', small);
      const res = await fetch('/api/admin/upload/', { method: 'POST', body: data });
      const result = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(result.error || 'Tải ảnh thất bại.');
      return result.url;
    }

    async function uploadVideo(file) {
      if (file.size > 50 * 1024 * 1024) throw new Error('Video quá lớn (tối đa 50 MB).');
      const res = await fetch('/api/admin/upload-video/', {
        method: 'POST',
        headers: { 'Content-Type': file.type },
        body: file,
      });
      const result = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(result.error || 'Tải video thất bại.');
      return result.url;
    }

    async function uploadMany(files, onUrl) {
      await withBusy(async () => {
        let done = 0;
        let failed = 0;
        let lastError = '';
        for (const file of files) {
          setStatus('Đang tải ảnh ' + (done + failed + 1) + '/' + files.length + '...');
          try {
            onUrl(await uploadImage(file));
            done++;
          } catch (err) {
            failed++;
            lastError = err && err.message ? err.message : 'không tải được';
          }
        }
        setStatus(
          failed
            ? 'Đã tải ' + done + ' ảnh, lỗi ' + failed + ': ' + lastError
            : 'Đã tải xong ' + done + ' ảnh. Nhớ bấm Lưu bên dưới.',
        );
      });
    }

    function renderGallery() {
      galleryEl.textContent = '';
      if (state.images.length === 0) {
        galleryEl.append(h('p', { class: 'adm-hint', text: 'Chưa có ảnh nào.' }));
        return;
      }
      state.images.forEach((url, i) => {
        galleryEl.append(
          h(
            'div',
            { class: 'pf-thumb' },
            h('img', { src: url, alt: '' }),
            i === 0 ? h('span', { class: 'pf-badge', text: 'Ảnh đại diện' }) : null,
            h(
              'div',
              { class: 'pf-thumb-actions' },
              h('button', {
                type: 'button',
                title: 'Chuyển sang trái',
                disabled: i === 0,
                text: '‹',
                onclick: () => {
                  swap(state.images, i, i - 1);
                  renderGallery();
                },
              }),
              h('button', {
                type: 'button',
                title: 'Chuyển sang phải',
                disabled: i === state.images.length - 1,
                text: '›',
                onclick: () => {
                  swap(state.images, i, i + 1);
                  renderGallery();
                },
              }),
              h('button', {
                type: 'button',
                class: 'danger',
                title: 'Xoá ảnh',
                text: '✕',
                onclick: () => {
                  state.images.splice(i, 1);
                  renderGallery();
                },
              }),
            ),
          ),
        );
      });
    }

    function renderSpecs() {
      specsEl.textContent = '';
      state.specs.forEach((row, i) => {
        specsEl.append(
          h(
            'div',
            { class: 'pf-spec-row' },
            h('input', {
              type: 'text',
              placeholder: 'Tên thông số (vd: Tốc độ)',
              value: row.label,
              oninput: (e) => {
                row.label = e.target.value;
              },
            }),
            h('input', {
              type: 'text',
              placeholder: 'Giá trị (vd: 25km/h)',
              value: row.value,
              oninput: (e) => {
                row.value = e.target.value;
              },
            }),
            h('button', {
              type: 'button',
              class: 'adm-icon-btn danger',
              title: 'Xoá dòng',
              text: '✕',
              onclick: () => {
                state.specs.splice(i, 1);
                renderSpecs();
              },
            }),
          ),
        );
      });
    }

    const LABELS = {
      heading: 'Tiêu đề',
      text: 'Đoạn văn',
      image: 'Ảnh',
      video: 'Video từ máy',
      youtube: 'Video YouTube',
    };

    function renderBlocks() {
      blocksEl.textContent = '';
      if (state.blocks.length === 0) {
        blocksEl.append(
          h('p', { class: 'adm-hint', text: 'Chưa có nội dung mô tả. Bấm các nút bên dưới để thêm.' }),
        );
      }
      const last = state.blocks.length - 1;
      state.blocks.forEach((block, i) => {
        let body = null;
        if (block.type === 'heading') {
          body = h('input', {
            type: 'text',
            placeholder: 'Nhập tiêu đề...',
            value: block.text || '',
            oninput: (e) => {
              block.text = e.target.value;
            },
          });
        } else if (block.type === 'text') {
          body = h('textarea', {
            rows: '5',
            placeholder: 'Nhập nội dung... (xuống dòng 2 lần để tách đoạn)',
            oninput: (e) => {
              block.text = e.target.value;
            },
          });
          body.value = block.text || '';
        } else if (block.type === 'image') {
          body = h('img', { class: 'pf-block-img', src: block.url, alt: '' });
        } else if (block.type === 'video') {
          body = h('video', { class: 'pf-block-video', src: block.url, controls: true, preload: 'metadata' });
        } else if (block.type === 'youtube') {
          body = h(
            'div',
            { class: 'pf-yt' },
            h('img', { src: 'https://i.ytimg.com/vi/' + block.id + '/hqdefault.jpg', alt: '' }),
            h('span', { text: 'youtube.com/watch?v=' + block.id }),
          );
        }

        blocksEl.append(
          h(
            'div',
            { class: 'pf-block' },
            h(
              'div',
              { class: 'pf-block-head' },
              h('strong', { text: LABELS[block.type] || block.type }),
              h(
                'div',
                { class: 'pf-block-actions' },
                h('button', {
                  type: 'button',
                  class: 'adm-icon-btn',
                  title: 'Lên',
                  disabled: i === 0,
                  text: '↑',
                  onclick: () => {
                    swap(state.blocks, i, i - 1);
                    renderBlocks();
                  },
                }),
                h('button', {
                  type: 'button',
                  class: 'adm-icon-btn',
                  title: 'Xuống',
                  disabled: i === last,
                  text: '↓',
                  onclick: () => {
                    swap(state.blocks, i, i + 1);
                    renderBlocks();
                  },
                }),
                h('button', {
                  type: 'button',
                  class: 'adm-icon-btn danger',
                  title: 'Xoá',
                  text: '✕',
                  onclick: () => {
                    state.blocks.splice(i, 1);
                    renderBlocks();
                  },
                }),
              ),
            ),
            body,
          ),
        );
      });
    }

    document.getElementById('pf-image-files').addEventListener('change', async (e) => {
      const room = Math.max(0, MAX_IMAGES - state.images.length);
      const files = Array.from(e.target.files || []).slice(0, room);
      e.target.value = '';
      if (files.length === 0) {
        setStatus('Đã đủ ' + MAX_IMAGES + ' ảnh.');
        return;
      }
      await uploadMany(files, (url) => {
        state.images.push(url);
        renderGallery();
      });
    });

    document.getElementById('pf-add-spec').addEventListener('click', () => {
      state.specs.push({ label: '', value: '' });
      renderSpecs();
    });

    document.querySelectorAll('[data-add]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const kind = btn.getAttribute('data-add');
        if (kind === 'heading' || kind === 'text') {
          state.blocks.push({ type: kind, text: '' });
          renderBlocks();
        } else if (kind === 'image') {
          blockImages.click();
        } else if (kind === 'video') {
          blockVideo.click();
        } else if (kind === 'youtube') {
          const input = window.prompt('Dán đường dẫn video YouTube (ví dụ: https://www.youtube.com/watch?v=...):');
          if (!input) return;
          const id = ytId(input);
          if (!id) {
            alert('Đường dẫn YouTube không hợp lệ.');
            return;
          }
          state.blocks.push({ type: 'youtube', id });
          renderBlocks();
        }
      });
    });

    blockImages.addEventListener('change', async (e) => {
      const files = Array.from(e.target.files || []);
      e.target.value = '';
      if (files.length === 0) return;
      await uploadMany(files, (url) => {
        state.blocks.push({ type: 'image', url });
        renderBlocks();
      });
    });

    blockVideo.addEventListener('change', async (e) => {
      const file = e.target.files && e.target.files[0];
      e.target.value = '';
      if (!file) return;
      await withBusy(async () => {
        setStatus('Đang tải video lên, có thể mất vài phút...');
        try {
          const url = await uploadVideo(file);
          state.blocks.push({ type: 'video', url });
          renderBlocks();
          setStatus('Đã tải video xong. Nhớ bấm Lưu bên dưới.');
        } catch (err) {
          setStatus('Lỗi: ' + (err && err.message ? err.message : 'không tải được video.'));
        }
      });
    });

    document.querySelectorAll('[data-money]').forEach((el) => {
      el.addEventListener('input', () => {
        const digits = el.value.replace(/\D/g, '');
        el.value = digits ? Number(digits).toLocaleString('vi-VN') : '';
      });
    });

    form.addEventListener('submit', (e) => {
      if (busy > 0) {
        e.preventDefault();
        alert('Đang tải file lên, vui lòng đợi xong rồi bấm Lưu.');
        return;
      }
      const blocks = state.blocks.filter((b) => {
        if (b.type === 'heading' || b.type === 'text') return (b.text || '').trim() !== '';
        if (b.type === 'youtube') return !!b.id;
        return !!b.url;
      });
      const specs = state.specs.filter((s) => s.label.trim() || s.value.trim());
      document.getElementById('pf-images-input').value = JSON.stringify(state.images);
      document.getElementById('pf-specs-input').value = JSON.stringify(specs);
      document.getElementById('pf-desc-input').value = JSON.stringify(blocks);
    });

    renderGallery();
    renderSpecs();
    renderBlocks();
  })();
</script>