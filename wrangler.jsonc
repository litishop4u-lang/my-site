{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-site",
  "compatibility_date": "2026-06-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trolucdien-db",
      "database_id": "c6b5c7af-24fd-4223-8b77-05832341c267",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "trolucdien-images"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}